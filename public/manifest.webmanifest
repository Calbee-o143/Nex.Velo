<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Games</title>
<style>
  html, body { margin: 0; min-height: 100%; background: #000; color: #fff; font-family: system-ui, sans-serif; }
  #games { min-height: 100vh; padding: 12px; box-sizing: border-box; }
  #msg { padding: 24px; color: rgba(255,255,255,.6); text-align: center; }
</style>
</head>
<body>
<div id="msg">loading games…</div>
<div id="games"></div>
<script src="https://cdn.jsdelivr.net/gh/luminsdk/script@latest/lumin.min.js"></script>
<script>
  if (window.Lumin) {
    Lumin.init({
      container: '#games',
      theme: 'dark',
      columns: 8,
      rows: 4,
      onReady: function () { document.getElementById('msg').remove(); },
      onError: function (e) { document.getElementById('msg').textContent = 'games failed to load: ' + (e && e.message ? e.message : e); }
    });
  } else {
    document.getElementById('msg').textContent = 'the games library could not be loaded.';
  }
</script>
</body>
</html>
